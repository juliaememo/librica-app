{
  "expo": {
    "name": "librica",
    "slug": "librica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/librica-icon.png",
    "scheme": "librica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.nextstation.librica"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/librica-splash.png",
        "backgroundColor": "#fbf9f5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.nextstation.librica"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/librica-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fbf9f5",
          "dark": {
            "image": "./assets/images/librica-splash.png",
            "backgroundColor": "#fbf9f5"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#fbf9f500",
          "barStyle": "dark"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14f5beef-90be-4b9c-81dd-94f9aa399fa9"
      }
    },
    "owner": "juliaememos-team"
  }
}
